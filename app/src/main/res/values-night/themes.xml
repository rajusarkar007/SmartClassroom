<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SmartClassroom"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Emerald Royal Primary -->
        <item name="colorPrimary">#34D399</item>
        <item name="colorPrimaryVariant">#059669</item>
        <item name="colorOnPrimary">#052E22</item>

        <!-- Secondary -->
        <item name="colorSecondary">#6EE7B7</item>
        <item name="colorSecondaryVariant">#10B981</item>
        <item name="colorOnSecondary">#052E22</item>

        <!-- Dark Background -->
        <item name="android:windowBackground">#0B1712</item>
        <item name="colorSurface">#14251D</item>
        <item name="colorOnSurface">#ECFDF5</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">#0B1712</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">#0B1712</item>

        <item name="android:windowActionModeOverlay">true</item>

    </style>

    <style name="Theme.SmartClassroom.AppBarOverlay"
        parent="ThemeOverlay.Material3.Dark" />

    <style name="Theme.SmartClassroom.PopupOverlay"
        parent="ThemeOverlay.Material3.Dark" />

</resources>
