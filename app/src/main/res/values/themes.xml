<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SmartClassroom"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Emerald Royal Primary -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_light</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/background</item>

        <!-- System UI -->
        <item name="android:windowActionModeOverlay">true</item>

    </style>

    <style name="Theme.SmartClassroom.AppBarOverlay"
        parent="ThemeOverlay.Material3.Dark" />

    <style name="Theme.SmartClassroom.PopupOverlay"
        parent="ThemeOverlay.Material3.Light" />

</resources>
