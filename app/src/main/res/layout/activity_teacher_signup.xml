<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#050806">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="#E8F2EB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="TEACHER REGISTRATION"
                android:textColor="#C6A15B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

        </LinearLayout>

        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_marginTop="28dp"
            android:background="#C6A15B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Join as an Educator."
            android:textColor="#F4F7F4"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Create and manage your classrooms with ease."
            android:textColor="#89968E"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="#101B15"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#294536"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROFESSIONAL INFORMATION"
                    android:textColor="#C6A15B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFullName"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:hint="@string/full_name"
                    app:boxBackgroundColor="#0A120D"
                    app:boxStrokeColor="#47765A"
                    app:hintTextColor="#C6A15B"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="#8CA995">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="#F4F7F4"
                        android:padding="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTeacherId"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/teacher_id"
                    app:boxBackgroundColor="#0A120D"
                    app:boxStrokeColor="#47765A"
                    app:hintTextColor="#C6A15B"
                    app:startIconDrawable="@drawable/ic_school"
                    app:startIconTint="#8CA995">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTeacherId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="#F4F7F4"
                        android:padding="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilInstitution"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/institution_name"
                    app:boxBackgroundColor="#0A120D"
                    app:boxStrokeColor="#47765A"
                    app:hintTextColor="#C6A15B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etInstitution"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textColor="#F4F7F4"
                        android:padding="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDepartment"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/department"
                    app:boxBackgroundColor="#0A120D"
                    app:boxStrokeColor="#47765A"
                    app:hintTextColor="#C6A15B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDepartment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textColor="#F4F7F4"
                        android:padding="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="22dp"
                    android:background="#294536" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCOUNT SECURITY"
                    android:textColor="#C6A15B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:hint="@string/email"
                    app:boxBackgroundColor="#0A120D"
                    app:boxStrokeColor="#47765A"
                    app:hintTextColor="#C6A15B"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="#8CA995">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="#F4F7F4"
                        android:padding="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/password"
                    app:boxBackgroundColor="#0A120D"
                    app:boxStrokeColor="#47765A"
                    app:hintTextColor="#C6A15B"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="#8CA995"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="#C6A15B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#F4F7F4"
                        android:padding="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConfirmPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/confirm_password"
                    app:boxBackgroundColor="#0A120D"
                    app:boxStrokeColor="#47765A"
                    app:hintTextColor="#C6A15B"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="#8CA995"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="#C6A15B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#F4F7F4"
                        android:padding="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignup"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="26dp"
                    android:text="Create Teacher Account"
                    android:textColor="#06110B"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#10B981"
                    app:cornerRadius="14dp"
                    app:elevation="0dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="14dp"
                    android:indeterminateTint="#C6A15B"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:text="SMART CLASSROOM  •  EDUCATOR PORTAL"
            android:textColor="#64766B"
            android:textSize="10sp"
            android:letterSpacing="0.12" />

    </LinearLayout>

</ScrollView>