<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:name=".SmartClassroomApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_school"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_school"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartClassroom">

        <activity
            android:name=".activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.LoginActivity" android:exported="false" />
        <activity android:name=".activities.StudentSignupActivity" android:exported="false" />
        <activity android:name=".activities.TeacherSignupActivity" android:exported="false" />
        <activity android:name=".activities.TeacherMainActivity" android:exported="false" />
        <activity android:name=".activities.StudentMainActivity" android:exported="false" />
        <activity android:name=".activities.CreateClassroomActivity" android:exported="false" />
        <activity android:name=".activities.ClassroomDetailActivity" android:exported="false" />
        <activity android:name=".activities.StudentManagementActivity" android:exported="false" />
        <activity android:name=".activities.AttendanceActivity" android:exported="false" />
        <activity android:name=".activities.AttendanceHistoryActivity" android:exported="false" />
        <activity android:name=".activities.MarksManagementActivity" android:exported="false" />
        <activity android:name=".activities.ScheduleActivity" android:exported="false" />
        <activity android:name=".activities.NoticeActivity" android:exported="false" />
        <activity android:name=".activities.ReportsActivity" android:exported="false" />
        <activity android:name=".activities.PersonalNotesActivity" android:exported="false" />
        <activity android:name=".activities.ProfileActivity" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
